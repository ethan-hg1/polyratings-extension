{
  "manifest_version": 3,
  "name": "Polyratings for Cal Poly Portal",
  "version": "0.1.0",
  "description": "Shows Polyratings professor ratings on the Cal Poly class search.",
  "browser_specific_settings": {
    "gecko": {
      "id": "polyratings-extension@ethan-hg1",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://cmsweb.pscs.calpoly.edu/psc/*"],
      "all_frames": true,
      "js": ["content.js"]
    }
  ],
  "background": { "scripts": ["background.js"], "type": "module" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://api-prod.polyratings.org/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
