{
  "manifest_version": 3,
  "name": "Polyratings for Cal Poly Portal",
  "version": "0.1.0",
  "description": "Shows Polyratings professor ratings on the Cal Poly class search.",
  "content_scripts": [
    {
      "matches": ["https://cmsweb.pscs.calpoly.edu/psc/*"],
      "all_frames": true,
      "js": ["content.js"]
    }
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://api-prod.polyratings.org/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
